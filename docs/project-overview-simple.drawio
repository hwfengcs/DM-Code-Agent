<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="通俗项目总览">
    <mxGraphModel dx="1700" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="&lt;b&gt;DM-Code-Agent：一个会实际干活、而且全程留记录的 AI 程序员框架&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;用户交代任务后，它会规划、调用本地工具、查看结果、失败后调整，最后给出可验证的结果。&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="120" y="20" width="1440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="3" value="&lt;b&gt;你交代任务&lt;/b&gt;&lt;br&gt;例如：修复重试逻辑&lt;br&gt;并运行测试" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="4" value="&lt;b&gt;CLI 组装工作台&lt;/b&gt;&lt;br&gt;选择模型、工具、技能&lt;br&gt;扩展和 MCP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="300" y="150" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="5" value="&lt;b&gt;规划器&lt;/b&gt;&lt;br&gt;先列出 3～8 步&lt;br&gt;执行计划" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="590" y="150" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="6" value="ReAct 循环：想一下 → 动手 → 看结果 → 再想" style="swimlane;startSize=40;rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=16;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="850" y="110" width="500" height="280" as="geometry" />
        </mxCell>
        <mxCell id="7" value="&lt;b&gt;大模型（脑子）&lt;/b&gt;&lt;br&gt;决定下一步&lt;br&gt;做什么" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="6">
          <mxGeometry x="30" y="70" width="120" height="90" as="geometry" />
        </mxCell>
        <mxCell id="8" value="&lt;b&gt;本地工具（手）&lt;/b&gt;&lt;br&gt;读/改文件&lt;br&gt;命令・测试・Lint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="6">
          <mxGeometry x="190" y="70" width="120" height="90" as="geometry" />
        </mxCell>
        <mxCell id="9" value="&lt;b&gt;观察结果（眼睛）&lt;/b&gt;&lt;br&gt;把成功或失败&lt;br&gt;反馈给模型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="6">
          <mxGeometry x="350" y="70" width="120" height="90" as="geometry" />
        </mxCell>
        <mxCell id="10" value="&lt;b&gt;完成并交付&lt;/b&gt;&lt;br&gt;最终答案&lt;br&gt;代码修改与验证结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1430" y="150" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="11" value="&lt;b&gt;插件插座&lt;/b&gt;&lt;br&gt;可增加工具、技能、模型供应商&lt;br&gt;和安全拦截规则" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="300" y="510" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="12" value="&lt;b&gt;安全护栏&lt;/b&gt;&lt;br&gt;先读后改・写前备份&lt;br&gt;重试・截断・断点恢复" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1000" y="510" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="13" value="&lt;b&gt;Trace / Checkpoint&lt;/b&gt;&lt;br&gt;像行车记录仪 + 游戏存档&lt;br&gt;可查看、分析、恢复、分叉" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1250" y="500" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="14" value="&lt;b&gt;Eval / Benchmark&lt;/b&gt;&lt;br&gt;像考试场&lt;br&gt;用测试判断是否真做对" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1500" y="510" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="20" value="任务" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=12;" edge="1" parent="1" source="3" target="4">
